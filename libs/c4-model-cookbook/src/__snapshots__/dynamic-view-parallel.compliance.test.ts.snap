// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`cookbook: dynamic-view-parallel > generates expected DSL 1`] = `
"workspace "Dynamic Parallel" {
  model {
    // Elements
    a = softwareSystem "A" {
      tags "Element" "Software System"
    }
    b = softwareSystem "B" {
      tags "Element" "Software System"
    }
    c = softwareSystem "C" {
      tags "Element" "Software System"
    }
    d = softwareSystem "D" {
      tags "Element" "Software System"
    }
    e = softwareSystem "E" {
      tags "Element" "Software System"
    }
    // Relationships
    a -> b "uses" {
      tags "Relationship"
    }
    b -> c "uses" {
      tags "Relationship"
    }
    b -> d "uses" {
      tags "Relationship"
    }
    b -> e "uses" {
      tags "Relationship"
    }
  }
  views {
    // System Landscape Views
    // System Context Views
    // Container Views
    // Component Views
    // Dynamic Views
    dynamic * "Dynamic" {
      a -> b "Makes a request to"
      {
        {
          b -> c "Gets data from"
        }
        {
          b -> d "Gets data from"
        }
      }
      b -> e "Sends data to"
      autoLayout
    }
  }
}
"
`;
